# Environment variables this project reads. Values come from the process environment (CI maps
# them into a job's `env:`) or a gitignored .env.local; never commit one.
# @defaultRequired=false @defaultSensitive=false
# ---

# Used by Mise when installing this project's pinned development tools.
# @sensitive @type=string
GITHUB_TOKEN=

# Takes precedence over GITHUB_TOKEN for Mise's own GitHub requests.
# @sensitive @type=string
MISE_GITHUB_TOKEN=

# Apple Developer download-session Cookie header. Pass it through the environment or Varlock;
# never put it in mise.toml, a lockfile, a task command, or release notes.
# @sensitive @type=string
MISE_XCODE_COOKIE=
